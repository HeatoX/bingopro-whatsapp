generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  name          String?
  pinHash       String?   // 4-digit PIN bcrypt hash
  email         String?
  cedula        String?   // V-12345678
  bankCode      String?   // 0102, 0105, 0108, etc.
  bankAccount   String?   // Telefono or account for Pago Movil / Transferencia
  isAdmin       Boolean   @default(false)
  isBlocked     Boolean   @default(false)
  registeredAt  DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  
  accounts      Account[]
  cards         Card[]
  deposits      PagoMovilDeposit[]
  withdrawals   WithdrawalRequest[]
  
  @@map("users")
}

// ============================================
// FINANCIAL SYSTEM - DOUBLE ENTRY LEDGER
// ============================================

model Account {
  id        String        @id @default(uuid())
  userId    String?
  type      String        // USER_REAL, HOUSE_REVENUE, HOUSE_ESCROW, PAYMENT_GATEWAY, HOUSE_JACKPOT
  currency  String        @default("VES")
  createdAt DateTime      @default(now())
  
  user          User?           @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]
  balance       AccountBalance?
  
  @@map("accounts")
}

model Transaction {
  id              String        @id @default(uuid())
  idempotencyKey  String        @unique
  type            String        // DEPOSIT, WITHDRAWAL, BUY_CARD, WIN_PAYOUT, etc.
  gameRoundId     String?
  description     String?
  metadata        String?
  createdAt       DateTime      @default(now())
  
  gameRound     GameRound?    @relation(fields: [gameRoundId], references: [id])
  ledgerEntries LedgerEntry[]
  
  @@map("transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String
  amount        Float
  balanceAfter  Float?
  createdAt     DateTime @default(now())
  
  transaction Transaction @relation(fields: [transactionId], references: [id])
  account     Account     @relation(fields: [accountId], references: [id])
  
  @@map("ledger_entries")
}

model AccountBalance {
  accountId        String   @id
  availableBalance Float    @default(0)
  lockedBalance    Float    @default(0)
  updatedAt        DateTime @default(now()) @updatedAt
  
  account Account @relation(fields: [accountId], references: [id])
  
  @@map("account_balances")
}

// ============================================
// GAME SYSTEM
// ============================================

model GameRound {
  id                  String     @id @default(uuid())
  roundNumber         Int        @unique
  status              String     @default("WAITING") // WAITING, SELLING, DRAWING, PAUSED, FINISHED, CANCELLED

  
  // Provably Fair
  serverSeed          String
  serverSeedHash      String
  clientSeed          String?
  
  // Financial
  totalCards          Int        @default(0)
  prizePool           Float      @default(0)
  houseRake           Float      @default(0)
  
  // Prize tracking
  prize1LineAmount    Float?
  prize2LinesAmount   Float?
  prizeFullCardAmount Float?
  
  winner1LineUserId   String?
  winner2LinesUserId  String?
  winnerFullCardUserId String?
  
  // Timestamps
  scheduledAt         DateTime
  sellingStartedAt    DateTime?
  drawingStartedAt    DateTime?
  finishedAt          DateTime?
  createdAt           DateTime   @default(now())
  
  cards         Card[]
  drawnBalls    DrawnBall[]
  transactions  Transaction[]
  
  @@map("game_rounds")
}

model Card {
  id            String   @id @default(uuid())
  cardNumber    Int
  hash          String   @unique
  userId        String
  gameRoundId   String
  grid          String   // 5x5 grid stored as JSON string
  purchasePrice Float
  isWinner      Boolean  @default(false)
  winType       String?  // "1LINE", "2LINES", "FULLCARD"
  purchasedAt   DateTime @default(now())
  
  user      User      @relation(fields: [userId], references: [id])
  gameRound GameRound @relation(fields: [gameRoundId], references: [id])
  
  @@map("cards")
}

model DrawnBall {
  id          String   @id @default(uuid())
  gameRoundId String
  number      Int
  sequence    Int      // Order in which it was drawn (1, 2, 3...)
  column      String   // B, I, N, G, O
  drawnAt     DateTime @default(now())
  
  gameRound GameRound @relation(fields: [gameRoundId], references: [id])
  
  @@map("drawn_balls")
}

// ============================================
// PAGO MÓVIL
// ============================================

model PagoMovilDeposit {
  id            String        @id @default(uuid())
  userId        String
  referenceCode String        @unique
  amount        Float
  bankCode      String
  phoneNumber   String
  status        String        @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  
  user User @relation(fields: [userId], references: [id])
  
  @@map("pago_movil_deposits")
}

model WithdrawalRequest {
  id              String        @id @default(uuid())
  userId          String
  amount          Float
  bankCode        String
  phoneNumber     String
  cedulaNumber    String
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  
  user User @relation(fields: [userId], references: [id])
  
  @@map("withdrawal_requests")
}
