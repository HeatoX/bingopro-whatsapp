# BingoPro Environment Variables

# Database
DATABASE_URL="postgresql://bingopro:bingopro_secret_2024@localhost:5432/bingopro?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# WhatsApp
WA_SESSION_NAME="BingoPro"

# Game Settings
GAME_INTERVAL_MINUTES=5
CARD_PRICE_BS=100
MAX_CARDS_PER_PLAYER=50
BALL_DRAW_INTERVAL_SECONDS=4
SELLING_WINDOW_SECONDS=60
MIN_PLAYERS_TO_START=2

# Prize Distribution (must sum to 100 with HOUSE)
HOUSE_PERCENTAGE=15
PRIZE_1_LINE_PERCENTAGE=10
PRIZE_2_LINES_PERCENTAGE=15
PRIZE_FULL_CARD_PERCENTAGE=60

# Admin Dashboard
ADMIN_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BingoPro2024!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Pago Móvil
